{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "installCommand": "npm install --ignore-scripts --package-lock=false",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/descargas/:path*",
      "destination": "https://descargas.letsurftogether.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!descargas/).*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"},
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800"}
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=600, must-revalidate"}
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=600, must-revalidate"}
      ]
    },
    {
      "source": "/descargas/(.*)",
      "headers": [
        {"key": "x-vercel-enable-rewrite-caching", "value": "1"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ],
  "redirects": [
    {
      "source": "/viajes/maldivas-2027-03-28/",
      "destination": "/viajes/maldivas-pascua/",
      "permanent": true
    },
    {
      "source": "/inscripciones/maldivas-2027-03-28/",
      "destination": "/inscripciones/maldivas-pascua/",
      "permanent": true
    },
    {
      "source": "/surftrips/",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/surftrips-pasados/",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/surfcamp-pasado/",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/sobre-lst/",
      "destination": "/conocenos/",
      "permanent": true
    },
    {
      "source": "/conoce-lst/",
      "destination": "/conocenos/",
      "permanent": true
    },
    {
      "source": "/servicios-2/",
      "destination": "/conocenos/",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/conocenos/",
      "permanent": true
    },
    {
      "source": "/rookies/",
      "destination": "/niveles/#nivel-1",
      "permanent": true
    },
    {
      "source": "/nivel-ii-aprendices/",
      "destination": "/niveles/#nivel-2",
      "permanent": true
    },
    {
      "source": "/nivel-iii-rides/",
      "destination": "/niveles/#nivel-3",
      "permanent": true
    },
    {
      "source": "/nivel-iv-supercracks/",
      "destination": "/niveles/#nivel-4",
      "permanent": true
    },
    {
      "source": "/contacto/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/hola-mundo/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mi-cuenta/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/terminos-y-condiciones-de-contratacion/",
      "destination": "/condiciones/",
      "permanent": true
    },
    {
      "source": "/producto/marruecos/",
      "destination": "/viajes/marruecos/",
      "permanent": true
    },
    {
      "source": "/producto/(.*)",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/categoria-producto/(.*)",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/tienda/(.*)",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/carrito/",
      "destination": "/viajes/",
      "permanent": true
    },
    {
      "source": "/finalizar-compra/(.*)",
      "destination": "/viajes/",
      "permanent": true
    }
  ]
}
