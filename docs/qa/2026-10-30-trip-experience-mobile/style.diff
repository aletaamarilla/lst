 }
+
+/* Surf as an experience, with the source programme kept directly below it. */
+.trip-designed .trip-programme>.programme-photo{margin:30px 0 26px}
+.trip-designed .programme-photo img{height:auto;aspect-ratio:16 / 10;max-height:460px;object-fit:cover}
+.trip-designed .day-rhythm{max-width:none;margin:0 0 30px}
+.trip-designed .day-rhythm>strong{font-size:14px;margin-bottom:0}
+.trip-designed .day-sequence{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin:18px 0 14px;padding:18px 0 0;border:0;border-top:1px solid var(--line);border-radius:0;background:transparent;overflow:visible}
+.trip-designed .day-sequence li{display:block;padding:0;font-size:13px;line-height:1.5;color:var(--ink)}
+.trip-designed .day-sequence li+li{border:0}
+.trip-designed .day-sequence li>span{display:block;margin-bottom:7px;color:#ad3e21;font:400 11px/1.5 var(--mono)}
+.trip-designed .day-rhythm>p{font-size:12px;line-height:1.7;max-width:65ch}
+.trip-designed .surf-plan-grid{grid-template-columns:minmax(0,1fr);gap:26px;margin-block:30px 46px}
+.trip-designed .surf-plan-grid article,.trip-designed .surf-plan-grid article:first-child{display:block;padding:24px 0 0;border:0;border-top:1px solid var(--line)}
+.surf-service-heading,.visual-card-heading{display:flex;align-items:baseline;gap:10px;min-width:0;margin-bottom:10px}
+.trip-designed .surf-service-heading .plan-number,.trip-designed .visual-card-heading .visual-card-index{display:inline-block;flex:0 0 auto;min-width:2ch;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#ad3e21;font:400 12px/1.5 var(--mono)}
+.trip-designed .surf-service-heading h3{margin:0;font:600 18px/1.35 var(--body);letter-spacing:-.025em}
+.trip-designed .visual-card-heading h3{margin:0}
+.trip-designed #spots>.section-heading h2{font:400 clamp(38px,5vw,58px)/1.04 var(--display)}
+
+/* Related destinations have a proper photograph and a clear route on small screens. */
+.trip-designed .related-section h2{font:400 clamp(38px,5vw,58px)/1.05 var(--display);letter-spacing:-.015em;max-width:22ch;margin-bottom:30px}
+.trip-designed .related-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:24px;margin-bottom:26px}
+.trip-designed .related-trip{display:grid;grid-template-columns:minmax(0,1fr) 64px;align-items:center;gap:0;padding:0;min-width:0;overflow:hidden;border:1px solid #d8cfb6;border-radius:4px 24px 4px 4px;background:var(--paper)}
+.trip-designed .related-trip img{grid-column:1 / -1;width:100%;height:auto;aspect-ratio:16 / 10;object-fit:cover;border-radius:0}
+.trip-designed .related-trip .related-trip-copy{grid-column:1;min-width:0;display:flex;flex-direction:column;gap:8px;margin:0;padding:20px}
+.trip-designed .related-trip .related-trip-name{font:400 clamp(28px,7.5vw,36px)/1.1 var(--display);letter-spacing:-.01em;overflow-wrap:anywhere}
+.trip-designed .related-trip small{font-size:13px;line-height:1.6}
+.trip-designed .related-trip .related-trip-arrow{grid-column:2;display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;margin-right:20px;border:1px solid var(--ink);border-radius:50%;color:var(--ink)}
+.trip-designed .related-trip-arrow .action-arrow{display:block}
+.trip-designed .related-trip:hover .related-trip-arrow{background:var(--ink);color:var(--paper)}
+.trip-designed .related-trip:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
+
+@media(min-width:700px){
+ .trip-designed .surf-plan-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
+}
+@media(max-width:999px){
+ .trip-designed .trip-dock{display:grid;grid-template-columns:minmax(0,1fr) auto 44px;align-items:center;gap:6px 8px}
+ .trip-designed .trip-dock .dock-offer{grid-column:1 / -1;font-size:11px;line-height:1.4;color:#ad3e21;margin:0}
+ .trip-designed .trip-dock .dock-details{display:flex;min-width:0;gap:2px}
+ .trip-designed .trip-dock .dock-details>span{font-size:11px;line-height:1.45}
+ .trip-designed .trip-dock .dock-details>.dock-deposit{color:var(--ink);font-size:10px}
+ .trip-designed .trip-dock .dock-cta{min-width:0;width:clamp(104px,29vw,122px);min-height:48px;padding-inline:10px;font-size:12px;flex:none}
+ .trip-designed .trip-dock .dock-whatsapp{display:inline-flex;align-items:center;justify-content:center;width:44px;min-width:44px;height:44px;min-height:44px;padding:0;border:1px solid var(--ink);border-radius:50%;background:transparent;color:var(--ink)}
+ .trip-designed .trip-dock .dock-whatsapp>span{display:none}
+ .trip-designed .trip-dock .dock-whatsapp .whatsapp-icon{width:22px;height:22px}
+ .trip-designed .trip-dock .dock-whatsapp:hover{background:var(--ink);color:var(--paper)}
+ .trip-designed .trip-dock .dock-whatsapp:focus-visible{outline:3px solid var(--orange);outline-offset:3px}
+}
+@media(max-width:359px){
+ .trip-designed .trip-dock .dock-cta{font-size:11px;letter-spacing:-.015em}
+ .trip-designed .trip-dock .dock-price strong{font-size:26px}
+ .trip-designed .trip-dock .dock-details>strong{font-size:16px}
+ .trip-designed .trip-dock .dock-details>span{font-size:10px}
+ .trip-designed .day-sequence{gap:10px}
+}
