+// Editorial names describe the destination; dates and levels belong to departures.
+export function tripName(name) {
+  return name.replace(/\s*·\s*(?:nivel(?:es)?\s+[\dIVX,\s–—-]+|Semana Santa(?:\s+\d{4})?|Pascua(?:\s+\d{4})?)\s*$/i, '').trim();
+}
+
+const programmeFields = ['intro', 'storyTitle', 'storyLabel', 'storyIntro', 'story', 'includes', 'excludes', 'inclusionsNote', 'faqs', 'levelTitle', 'levelText', 'levelChecks', 'stay', 'team'];
+const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
+const pickProgramme = trip => Object.fromEntries(programmeFields.filter(k => trip[k] !== undefined).map(k => [k, trip[k]]));
+export const aggregateAvailability = departures => !departures.length ? 'enquiry' : departures.every(d => d.availability === 'full') ? 'full'
+  : departures.some(d => d.availability === 'available') ? 'available'
+  : departures.some(d => d.availability === 'last_places') ? 'last_places' : 'enquiry';
+
+// The existing import uses destination-YYYY-MM-DD slugs. Consolidate those
+// documents for presentation, keeping every original URL and programme intact.
+// Custom slugs and single documents with several dates keep their own identity.
+export function consolidateTrips(trips) {
+  const groups = new Map();
+  for (const trip of trips) {
+    const destination = trip.slug.replace(/-\d{4}-\d{2}-\d{2}$/, '');
+    const key = JSON.stringify([destination, trip.name]);
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(trip);
+  }
+  const result = [];
+  for (const members of groups.values()) {
+    if (members.length === 1 && !/-\d{4}-\d{2}-\d{2}$/.test(members[0].slug)) { result.push(members[0]); continue; }
+    members.sort((a, b) => (a.departures[0]?.start ?? '9999').localeCompare(b.departures[0]?.start ?? '9999'));
+    const first = members[0];
+    const slug = first.slug.replace(/-\d{4}-\d{2}-\d{2}$/, '');
+    const differing = programmeFields.filter(k => members.some(t => !same(t[k], first[k])));
+    const trip = {...first, state: members.some(t => t.state === 'confirmed') ? 'confirmed' : 'upcoming', id: slug, slug, aliases: members.map(t => t.slug).filter(alias => alias !== slug), departures: [],
+      dossier: members.length === 1 ? first.dossier : '', capacity: members.length === 1 ? first.capacity : {total: null, available: null}};
+    for (const key of differing) trip[key] = Array.isArray(first[key])
+      ? first[key].filter(value => members.every(t => t[key]?.some(v => same(value, v))))
+      : undefined;
+    if (!trip.intro) trip.intro = 'Elige tu fecha para consultar el nivel, el programa y los servicios de cada salida.';
+    if (!trip.levelText) trip.levelText = 'Consulta el nivel y los requisitos de cada fecha antes de apuntarte.';
+    if (!trip.levelTitle) trip.levelTitle = 'Tu nivel de surf.';
+    if (!trip.storyTitle) trip.storyTitle = 'El programa.';
+    if (!trip.storyLabel) trip.storyLabel = 'EL VIAJE';
+    trip.storyIntro ??= '';
+    trip.inclusionsNote ??= '';
+    for (const member of members) {
+      for (const departure of member.departures) {
+        trip.departures.push({...departure,
+          ...(departure.levels || same(member.levels, first.levels) ? {} : {levels: member.levels}),
+          levelRequirement: departure.levelRequirement ?? member.levelRequirement,
+          dossier: departure.dossier || member.dossier,
+          availability: departure.availability ?? member.availability,
+          capacity: departure.capacity ?? member.capacity,
+          payment: member.payment,
+          ...(differing.length ? {programme: pickProgramme(member)} : {}),
+        });
+      }
+    }
+    if (new Set(trip.departures.map(d => d.id)).size !== trip.departures.length) throw Error('Claves de salida duplicadas al unificar viajes');
+    trip.departures.sort((a, b) => a.start.localeCompare(b.start));
+    trip.availability = aggregateAvailability(trip.departures);
+    if (!members.every(t => same(t.payment, first.payment))) trip.payment = {depositAmount: null, terms: ''};
+    result.push(trip);
+  }
+  const routes = result.flatMap(t => [t.slug, ...(t.aliases ?? [])]);
+  if (new Set(routes).size !== routes.length) throw Error('Colisión de rutas al unificar viajes');
+  return result;
+}
