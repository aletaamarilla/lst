+
+// Programme links leave the modal and open the matching date in the page.
+document.querySelectorAll('[data-view-programme]').forEach(link => {
+  link.addEventListener('click', event => {
+    const programme = document.getElementById(link.hash.slice(1));
+    if (!programme) return;
+    event.preventDefault();
+    const dialog = link.closest('dialog');
+    const reveal = () => {
+      programme.open = true;
+      history.replaceState(null, '', link.hash);
+      programme.scrollIntoView({behavior: 'instant', block: 'start'});
+      programme.querySelector('summary').focus({preventScroll: true});
+    };
+    if (dialog?.open) {
+      dialog.addEventListener('close', () => requestAnimationFrame(reveal), {once: true});
+      dialog.close();
+    } else reveal();
+  });
+});
