@@ -0,0 +1,32 @@
+import {brevoConfig, brevoValue, registrationDepartures} from './brevo.mjs';
+import {departureLevelLabel} from './trip-model.mjs';
+
+const escape = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const error = '<label class="entry__error entry__error--primary"></label>';
+const field = (name, label, {required = true, type = 'text', autocomplete = 'off', attrs = '', help = ''} = {}) => `<div class="sib-input sib-form-block"><div class="form__entry entry_block"><div class="form__label-row"><label class="entry__label" for="${name}">${label}${required ? ' *' : ' (opcional)'}</label><div class="entry__field"><input class="input" type="${type}" id="${name}" name="${name}"${name === 'EMAIL' ? '' : ' maxlength="200"'} autocomplete="${autocomplete}"${required ? ' data-required="true" required' : ''}${help ? ` aria-describedby="help-${name}"` : ''} ${attrs}></div>${help ? `<p class="registration-help" id="help-${name}">${help}</p>` : ''}</div>${error}</div></div>`;
+const choices = (name, title, values) => `<fieldset class="sib-radiobutton-group sib-form-block" data-required="true"><legend>${title} *</legend><div class="form__entry entry_mcq"><div class="form__label-row"><div class="registration-choices">${values.map((label, i) => `<div class="entry__choice"><label><input type="radio" name="${name}" class="input_replaced" value="${i + 1}" required><span class="radio-button"></span><span>${label}</span></label></div>`).join('')}</div></div>${error}</div></fieldset>`;
+const section = (number, title, content) => `<section class="registration-section" aria-labelledby="section-${number}"><h2 id="section-${number}"><span>${number}</span>${title}</h2>${content}</section>`;
+
+function phone() {
+  return `<div class="sib-sms-field sib-form-block"><div class="form__entry entry_block"><div class="form__label-row"><label class="entry__label" for="WHATSAPP">WhatsApp *</label><div class="sib-sms-input-wrapper"><div class="sib-sms-input" data-placeholder="WhatsApp" data-required="true" data-country-code="ES" data-value="" data-attributename="WHATSAPP"><div class="entry__field"><select class="input" name="WHATSAPP__COUNTRY_CODE" aria-label="Prefijo de país de WhatsApp" data-required="true">${brevoConfig.countries.map(c => `<option value="${escape(c.value)}"${c.label === '+34 ES' ? ' selected' : ''}>${escape(c.label)}</option>`).join('')}</select><input type="tel" class="input" id="WHATSAPP" name="WHATSAPP" autocomplete="tel-national" placeholder="Tu número" data-required="true" required></div><div class="sib-sms-tooltip"><div class="sib-sms-tooltip__box">Incluye tu número sin el prefijo del país.</div></div></div></div></div>${error}</div></div>`;
+}
+
+function form(trip, departures, selected, unavailableAlias) {
+  const dates = `<fieldset class="sib-radiobutton-group sib-form-block registration-dates" data-required="true"><legend>Tu fecha para ${escape(trip.name)} *</legend><div class="form__entry entry_mcq"><div class="form__label-row"><div class="registration-choices">${departures.map(d => `<div class="entry__choice"><label><input type="radio" name="VIAJE_SURF" class="input_replaced" value="${brevoValue(trip, d)}" data-departure-id="${escape(d.id)}"${selected?.id === d.id ? ' checked' : ''} required><span class="radio-button"></span><span><strong>${escape(d.date)}</strong><small>${escape(departureLevelLabel(trip, d))} · ${escape(d.duration)}</small></span></label></div>`).join('')}</div></div>${error}</div></fieldset>`;
+  const personal = `<div class="registration-grid">${field('NOMBRE', 'Nombre', {autocomplete:'given-name'})}${field('APELLIDOS', 'Apellidos', {autocomplete:'family-name'})}${field('EMAIL', 'Email', {type:'email', autocomplete:'email'})}${phone()}${field('FECHADENACIMIENTO', 'Fecha de nacimiento', {attrs:'data-type="date" pattern="^([0-2][0-9]|(3)[0-1])(-)(((0)[0-9])|((1)[0-2]))(-)\\d{4}$" title="dd-mm-aaaa" data-format="dd-mm-yyyy" placeholder="dd-mm-aaaa"', help:'Día, mes y año. Por ejemplo: 15-06-1995.'})}${field('DNI', 'DNI / documento de identidad')}${field('DIRECCION', 'Dirección', {autocomplete:'street-address'})}${field('CIUDAD', 'Ciudad', {autocomplete:'address-level2'})}${field('CODIGO_POSTAL', 'Código postal', {autocomplete:'postal-code', attrs:'data-numeric="true" inputmode="numeric" pattern="[0-9]+"'})}${field('PAIS', 'País', {autocomplete:'country-name'})}</div>`;
+  const surf = choices('NIVEL_SURF', '¿Cuál es tu nivel de surf?', ['Nivel 1, iniciación','Nivel 2, nivel base de surf','Nivel 3, intermedio','Nivel 4, controlo']) + '<p class="registration-help"><a href="/niveles/" target="_blank" rel="noopener">Consulta nuestra guía de niveles</a> si tienes dudas.</p>' + choices('TALLA_CAMISETA', 'Talla de camiseta', ['S','M','L','XL']) + choices('CONQUIENVIAJO', '¿Cómo vendrías al surftrip?', ['Sol@ a la aventura!','Acompañad@ o con amigos!']) + field('ACOMPANANTES', 'Si vienes con gente, ¿cuáles son sus nombres?', {required:false}) + choices('MATERIAL', 'En cuanto al material', ['Llevo el mio propio','Alquilaré una tabla']) + field('MATERIAL_MEDIDAS', 'Si vas a alquilar, ¿qué medidas crees que necesitas?', {required:false});
+  const more = field('ALERGIAS_INTOLERANCIAS', '¿Tienes alergias o alguna preferencia alimenticia?', {required:false}) + field('ENFERMEDAD_PROBLEMA', '¿Tienes alguna enfermedad o problema que te impida surfear y viajar de forma segura?', {required:false}) + field('MOTIVA', '¿Qué te motiva para unirte a este viaje con LST?') + choices('CONOCIDO', '¿Cómo has conocido este viaje?', ['Ya he viajado con Lets Surf Together','Recomendaciones de amigos/conocidos','Redes sociales! Mi primer viaje con LST!','Pagina Web','Otros']);
+  return `<div class="sib-form"><div id="sib-form-container" class="sib-form-container"><div id="error-message" class="sib-form-message-panel" role="alert"><div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">Vaya, no hemos podido procesar tu inscripción. Inténtalo de nuevo en unos minutos.</span></div></div><div id="success-message" class="sib-form-message-panel" role="status" tabindex="-1"><div class="sib-form-message-panel__text"><span class="sib-form-message-panel__inner-text">¡Genial! Tu inscripción se ha enviado correctamente. El equipo de LST revisará tus datos para confirmar la plaza contigo.</span></div></div><div id="sib-container" class="sib-container--large sib-container--vertical"><form id="sib-form" method="POST" action="${escape(brevoConfig.action)}" data-type="subscription">${section('01','El viaje empieza aquí.', dates)}<p id="registration-date-error" role="alert"${unavailableAlias ? '' : ' hidden'}>La fecha del enlace no está disponible. Elige una de las fechas que aparecen arriba.</p>${departures.length > 1 ? '<noscript><p>Comprueba y selecciona tu fecha antes de enviar la inscripción.</p></noscript>' : ''}${section('02','Un poco sobre ti.', personal)}${section('03','Tu surf. Tu plan.', surf)}${section('04','Antes de hacer la maleta.', more)}<div class="registration-submit sib-form-block"><p>Los campos con * son obligatorios. Al enviar, tus datos se tramitan a través de Brevo para gestionar esta inscripción. La plaza se confirma con el equipo.</p><button class="sib-form-block__button sib-form-block__button-with-loader button" form="sib-form" type="submit"><svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512" aria-hidden="true"><path d="M256 24a232 232 0 0 1 232 232h-48A184 184 0 0 0 256 72Z"/></svg>Me apunto al viaje</button></div><input type="text" name="email_address_check" value="" class="input--hidden" tabindex="-1" autocomplete="off" aria-hidden="true"><input type="hidden" name="locale" value="es"></form></div></div></div>`;
+}
+
+export function renderRegistration(trip, routeSlug = trip.slug) {
+  const departures = registrationDepartures(trip);
+  const aliasStart = routeSlug !== trip.slug ? /-(\d{4}-\d{2}-\d{2})$/.exec(routeSlug)?.[1] : '';
+  const selected = aliasStart ? departures.find(d => d.start === aliasStart) : departures.length === 1 ? departures[0] : undefined;
+  const contact = `<a class="text-link" data-whatsapp="${escape(trip.id)}" href="https://wa.me/34648189257?text=${encodeURIComponent(`¡Hola, LST! Tengo una duda sobre la inscripción a ${trip.name}.`)}" target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a>`;
+  return `<!doctype html>
